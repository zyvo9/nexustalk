# Copy this file to .env and fill in your values.

# Google OAuth (free): create a client at https://console.cloud.google.com
# APIs & Services → Credentials → Create OAuth client ID (Web application)
#   Authorized JavaScript origins: http://localhost:3000
#   Authorized redirect URIs:      http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Where this server is reachable (for the OAuth redirect back)
PUBLIC_BASE=http://localhost:4000

# Where the web UI lives (Google redirects here after login)
FRONTEND_URL=http://localhost:3000
