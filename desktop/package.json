{
  "name": "nexustalk-desktop",
  "version": "1.0.0",
  "description": "NexusTalk — chat, calls & remote desktop (Windows app)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.nexustalk.desktop",
    "productName": "NexusTalk",
    "files": ["main.js", "preload.js", "icon.png", "app-ui/**/*"],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
